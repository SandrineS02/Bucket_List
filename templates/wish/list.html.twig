{% extends 'base.html.twig' %}

{%  block title %}
    {{ parent()}} Liste de souhaits
{% endblock %}

{%  block body %}
    <section class="wishes-list">
        <h1>Liste de souhaits</h1>
        {% for wish in wishes %}
            <article>
                <a href="{{ path('wish_detail', {id: wish.id}) }}"
                   title="Détail d'un souhait">
                    {{ wish.title }}
                </a>
                <a href="{{ path('wish_detail', {id: wish.id}) }}"
                   title="Modifier le souhait">
                    {{ wish.title }}
                </a>
            </article>
        {% endfor %}
    </section>

{% endblock %}
